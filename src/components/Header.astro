---
import { site } from "../lib/site";
const about = Astro.url.pathname.replace(/\/$/, "") === "/about";
---

<header>
	<a class="name" href="/">
		{site.name}
		<span aria-hidden="true">.</span>
	</a>
	<nav aria-label="Main navigation">
		<a href="/" aria-current={!about ? "page" : undefined}>
			Writing
		</a>
		<a href="/about/" aria-current={about ? "page" : undefined}>
			About
		</a>
	</nav>
</header>

<style>
	header {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		padding-block: 52px 48px;
	}

	.name {
		color: var(--text);
		font-size: 1.2rem;
		font-weight: 600;
		letter-spacing: -0.7px;
	}

	.name span {
		color: var(--accent);
	}

	nav {
		display: flex;
		gap: 24px;
		font-size: 0.8rem;
	}

	nav a {
		color: var(--muted);
	}

	nav a[aria-current] {
		color: var(--text);
		text-decoration: underline;
		text-decoration-color: var(--border);
		text-underline-offset: 7px;
	}

	@media (max-width: 480px) {
		header {
			padding-block: 32px 36px;
		}
	}
</style>
