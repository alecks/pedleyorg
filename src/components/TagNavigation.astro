---
import { tagHref, type Tag } from "../lib/tags";
interface Props {
	tags: Tag[];
	activeSlug?: string;
}
const { tags, activeSlug } = Astro.props;
---

{tags.length > 0 && (
	<nav aria-label="Browse posts by tag">
		<ul>
			<li>
				<a href="/" aria-current={!activeSlug ? "page" : undefined}>
					All posts
				</a>
			</li>
			{tags.map((tag) => (
				<li>
					<a
						href={tagHref(tag.label)}
						aria-current={activeSlug === tag.slug ? "page" : undefined}
					>
						{tag.label}
					</a>
				</li>
			))}
		</ul>
	</nav>
)}

<style>
	nav {
		margin-bottom: 32px;
	}
	ul {
		display: flex;
		flex-wrap: wrap;
		gap: 10px 20px;
		list-style: none;
		margin: 0;
		padding: 0;
		font-size: 0.8rem;
	}
	a {
		color: var(--muted);
	}
	a[aria-current="page"] {
		color: var(--text);
		text-decoration: underline;
		text-decoration-color: var(--accent);
		text-underline-offset: 6px;
	}
</style>
