---
import { profile } from "../consts";
---

<section aria-labelledby="projects-title">
	<h2 id="projects-title">Projects</h2>
	<ul class="projects">
		{profile.projects.map((project) => (
			<li>
				<div class="project-heading">
					<h3>
						{project.href ? (
							<a href={project.href}>
								{project.name}
								<span class="project-arrow" aria-hidden="true">
									↗
								</span>
							</a>
						) : (
							project.name
						)}
					</h3>
					<span class="project-year">{project.year}</span>
				</div>
				{project.description && <p>{project.description}</p>}
				{project.technologies?.length ? (
					<p class="technologies">{project.technologies.join(", ")}</p>
				) : null}
			</li>
		))}
	</ul>
</section>

<style>
	section {
		margin-top: 40px;
	}

	h2 {
		font-size: 1.1rem;
	}

	.projects {
		list-style: none;
		padding: 0;
		margin: 20px 0 0;
	}

	.projects > li {
		padding-block: 20px;
		border-top: 1px solid var(--border);
	}

	.projects > li:last-child {
		padding-bottom: 0;
	}

	.project-heading {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 20px;
	}

	.project-year {
		flex-shrink: 0;
		color: var(--muted);
		font-family: var(--mono);
		font-size: 0.7rem;
	}

	h3 a {
		color: var(--text);
	}

	.project-arrow {
		margin-left: 8px;
		color: var(--accent);
		font-size: 0.7rem;
	}

	h3 {
		font-size: 1rem;
		font-weight: 500;
	}

	li p {
		margin: 6px 0 0;
		color: var(--muted);
		font-size: 0.9rem;
		line-height: 1.6;
	}

	.projects .technologies {
		margin-top: 8px;
		font-family: var(--mono);
		font-size: 0.7rem;
	}
</style>
