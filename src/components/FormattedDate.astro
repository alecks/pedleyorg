---
interface Props {
	date: Date;
	includeYear?: boolean;
}

const { date, includeYear = true } = Astro.props;
---

<time datetime={date.toISOString().slice(0, 10)}>
	{date.toLocaleDateString("en-GB", {
		year: includeYear ? "numeric" : undefined,
		month: "short",
		day: "2-digit",
		timeZone: "UTC",
	})}
</time>
