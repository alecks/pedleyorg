---
import { tagHref } from "../lib/tags";
interface Props {
	tags: string[];
}
const { tags } = Astro.props;
---

{tags.length > 0 && (
	<ul class="post-tags" aria-label="Post tags">
		{tags.map((tag) => (
			<li>
				<a href={tagHref(tag)}>{tag}</a>
			</li>
		))}
	</ul>
)}

<style>
	.post-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 8px 16px;
		list-style: none;
		margin: 16px 0 0;
		padding: 0;
		font-size: 0.8rem;
		line-height: 1.5;
	}
</style>
