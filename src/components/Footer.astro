---
import ContactLinks from "./ContactLinks.astro";
import ThemeSelect from "./ThemeSelect.astro";
import { site } from "../lib/site";
---

<footer>
	<ContactLinks />
	<ThemeSelect />
	{site.repositoryUrl && (
		<p class="source-note">
			This website is open-source! <a href={site.repositoryUrl}>Use it as a template</a>
		</p>
	)}
</footer>

<style>
	footer {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 24px;
		margin-top: 72px;
		padding-block: 20px 40px;
		border-top: 1px solid var(--border);
		font-size: 0.7rem;
	}

	footer :global(a) {
		color: var(--muted);
	}

	.source-note {
		width: 100%;
		margin: 0;
		color: var(--muted);
	}

	@media (max-width: 380px) {
		footer {
			align-items: flex-start;
			flex-direction: column;
			gap: 18px;
		}
	}
</style>
