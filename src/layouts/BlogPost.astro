---
import type { CollectionEntry } from "astro:content";
import Page from "./Page.astro";
import TagLinks from "../components/TagLinks.astro";
import FormattedDate from "../components/FormattedDate.astro";
import { site } from "../lib/site";

type Props = CollectionEntry<"blog">["data"];
const { title, description, pubDate, updatedDate, tags } = Astro.props;
const email = site.links.find((link) => link.href?.startsWith("mailto:"));
const replyHref = email?.href
	? `${email.href}?subject=${encodeURIComponent(`Re: ${title}`)}`
	: undefined;
---

<Page
	title={`${title} / ${site.name}`}
	description={description}
	type="article"
>
	<article>
		<header class="post-header">
			<div class="dates">
				<FormattedDate date={pubDate} />
				{updatedDate && (
					<span>
						Updated <FormattedDate date={updatedDate} />
					</span>
				)}
			</div>
			<h1>{title}</h1>
			<TagLinks tags={tags} />
		</header>
		<div class="prose">
			<slot />
		</div>
		{replyHref && <p><a href={replyHref}>Reply by email</a></p>}
	</article>
	<a class="back" href="/">
		<span aria-hidden="true">←</span> Back to writing
	</a>
</Page>

<style>
	.post-header {
		margin-bottom: 32px;
	}

	.dates {
		display: flex;
		flex-wrap: wrap;
		gap: 8px 20px;
		margin-bottom: 14px;
		color: var(--muted);
		font: 0.7rem/1.6 var(--mono);
	}

	h1 {
		max-width: 35rem;
		font-size: 1.75rem;
		letter-spacing: -0.9px;
		line-height: 1.25;
		text-wrap: balance;
	}

	.back {
		display: inline-block;
		margin-top: 40px;
		font-size: 0.8rem;
	}

	.back span {
		margin-right: 6px;
	}
</style>
